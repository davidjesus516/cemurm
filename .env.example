# CEMURM — Environment variables for collaborators
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local (it's in .gitignore).

# =============================================================================
# REQUIRED — Supabase (frontend)
# The app will NOT start without both of these.
# Choose ONE environment — local is default for development.
# =============================================================================

# --- LOCAL (default, development) ---
# Run `supabase start` then `supabase status` to get the anon key.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-key-from-supabase-start

# --- HOSTED (production/staging) ---
# Uncomment to use the hosted project instead of local:
# VITE_SUPABASE_URL=https://kspnacfcietqikbufcka.supabase.co
# VITE_SUPABASE_ANON_KEY=sb_publishable_F8S9vCVT-HoVRa31p-Bn7g_e3t3lCw1

# =============================================================================
# OPTIONAL — External providers for frontend (default = mock, no silent fallback)
# Uncomment and fill to enable real providers.
# =============================================================================

# Spotify (import/enrichment) — client-credentials flow runs in browser
# VITE_SPOTIFY_CLIENT_ID=
# VITE_SPOTIFY_CLIENT_SECRET=

# MusicBrainz (metadata enrichment) — credential-free API, flag for rate-limit/CORS control
# VITE_MUSICBRAINZ_LIVE=true

# lrclib (lyrics enrichment) — credential-free API, flag for rate-limit/CORS control
# VITE_LRCLIB_LIVE=true

# =============================================================================
# EDGE FUNCTION ENV — supabase/functions/.env (server-side only, NEVER in VITE_*)
# Copy this section to supabase/functions/.env (create the file, gitignored).
# These values NEVER reach the browser — they stay in the Deno runtime.
# =============================================================================

# SITE_URL — absolute origin for guardian consent links (e.g. http://localhost:5173)
# The function does NOT trust the request's Origin header (spoofable).
# Without it: 503 {"error":"app_url_not_configured"}
# SITE_URL=http://localhost:5173

# RESEND_FROM — sender address for guardian emails
# Resend only accepts a from-address on a VERIFIED domain.
# Local test: use Resend's test sender (delivers ONLY to your Resend account email)
# RESEND_FROM=onboarding@resend.dev
# Production: verify domain in Resend (DNS SPF/DKIM), then use guardian@cemurm.app
# RESEND_FROM=guardian@cemurm.app

# RESEND_API_KEY — goes to Supabase VAULT, NOT in any .env file:
#   docker exec -i supabase_db_cemurm psql -U postgres -d postgres \
#     -c "select vault.create_secret('re_…', 'resend_api_key', 'Guardian email sender');"
# The function reads it via public.read_resend_api_key() (service_role only).
# Without Vault key: 503 {"error":"email_not_configured"} — stack still works.

# =============================================================================
# Notes for collaborators
# =============================================================================
# 1. Development uses the LOCAL Supabase stack (PostgreSQL + GoTrue + RLS).
#    Run `supabase start` → Docker, applies migrations 0001–0033 + seed.sql.
#    The hosted project (kspnacfcietqikbufcka.supabase.co) is for prod/staging.
#
# 2. To get local keys:
#    $ supabase start
#    $ supabase status
#    Copy "API URL" and "anon key" into .env.local
#
# 3. External providers are OFF by default (mock mode).
#    The import/enrichment clients never throw — they return:
#      { ok: false, error: 'offline' | 'unavailable' }
#    when credentials or network are missing.
#
# 4. GoTrue v2 requires empty strings ('') for token/phone columns, not NULL.
#    The seed handles this; just run `supabase db reset` after start.
#
# 5. Two env files, two scopes:
#    - .env.local (root)         → Vite bundle → browser (VITE_* only)
#    - supabase/functions/.env   → Edge Function runtime → server only
#    - RESEND_API_KEY            → Supabase Vault only (never in files)