# CEMURM — environment variables
# Copy this file to `.env.local` (gitignored) and fill in the values.
# Local values come from `supabase status` — see docs/local-dev.md.

# Anything prefixed VITE_ ships to the browser bundle. Public-by-design values
# only (URLs, anon keys). NEVER put a secret here.

# Required — src/data/supabase.js throws at startup if either is missing.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Optional enrichment providers. Default is mock; there is no silent fallback.
# VITE_SPOTIFY_CLIENT_ID=
# VITE_SPOTIFY_CLIENT_SECRET=
# VITE_MUSICBRAINZ_LIVE=true
# VITE_LRCLIB_LIVE=true
