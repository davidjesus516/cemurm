@startuml uc04
skinparam shadowing false
skinparam ArrowStyle none
skinparam ArrowColor #8B8FA3
skinparam defaultFontColor #E2E4E9
skinparam nodesep 60
skinparam ranksep 100
skinparam rectangle {
  BorderColor #4A5068
  BackgroundColor #232733
  FontColor #E2E4E9
  FontStyle bold
}
skinparam usecase {
  BorderColor #4A5068
  BackgroundColor #232733
  FontColor #E2E4E9
  DiamondColor #4A5068
}
skinparam actor {
  BorderColor #E2E4E9
  FontColor #E2E4E9
}

left to right direction

actor "Administrador\n<<actor>>" as OrgAdmin

rectangle "CEMURM" {

  usecase "Gestionar cuentas\nde la organización\n[UC1]" as UC1

  usecase "Registrar alta\ny baja de un miembro\n[UC2]" as UC2

  usecase "Asignar un rol\ndentro de la organización\n[UC3]" as UC3
}

OrgAdmin -- UC1

UC1 ..> UC2 : <<include>>
UC1 ..> UC3 : <<extend>>

@enduml