# Generated locally by playwright.config.js; the HTML report embeds test
# source and console output, so it must never be committed.
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/

# Misc
*.tsbuildinfo

# Tooling artifacts
.codebase-memory/
.obsidian/

# Local Obsidian vault (notes only, never ship)
CEMURM/

